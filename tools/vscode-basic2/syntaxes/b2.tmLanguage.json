{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "BASIC-2",
    "scopeName": "source.basic2",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#preprocessor" },
        { "include": "#constants" },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "include": "#numbers" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.apostrophe.basic2",
            "begin": "'",
            "end": "$"
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.triple.basic2",
                    "begin": "\"\"\"",
                    "end": "\"\"\""
                },
                {
                    "name": "string.quoted.double.basic2",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        { "name": "constant.character.escape.basic2", "match": "\\\\." }
                    ]
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "keyword.control.preprocessor.basic2",
                    "match": "(?i)\\$(INCLUDE|DEFINE|UNDEF|IFDEF|IFNDEF|ELSE|ENDIF|PRAGMA|ERROR|WARNING)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.basic2",
                    "match": "(?i)\\b(TRUE|FALSE|NIL|NULL)\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.conditional.basic2",
                    "match": "(?i)\\bEND\\s+IF\\b"
                },
                {
                    "name": "keyword.control.conditional.basic2",
                    "match": "(?i)\\b(IF|THEN|ELSE|ELSEIF|ENDIF)\\b"
                },
                {
                    "name": "keyword.control.loop.basic2",
                    "match": "(?i)\\b(FOR|TO|STEP|NEXT|WHILE|WEND|DO|LOOP|UNTIL|REPEAT|EXIT|BREAK|CONTINUE)\\b"
                },
                {
                    "name": "keyword.control.flow.basic2",
                    "match": "(?i)\\b(GOTO|GOSUB|RETURN|END)\\b"
                },
                {
                    "name": "keyword.control.sub.basic2",
                    "match": "(?i)\\bEND\\s+SUB\\b"
                },
                {
                    "name": "keyword.control.sub.basic2",
                    "match": "(?i)\\bEND\\s+FUNCTION\\b"
                },
                {
                    "name": "keyword.control.sub.basic2",
                    "match": "(?i)\\b(SUB|CALL|FUNCTION)\\b"
                },
                {
                    "name": "storage.type.basic2",
                    "match": "(?i)\\b(GLOBAL|LOCAL|DIM|CONST)\\b"
                },
                {
                    "name": "keyword.operator.word.basic2",
                    "match": "(?i)\\b(AND|OR|NOT|XOR|MOD)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.graphics.basic2",
                    "match": "(?i)\\b(CLS|PSET|PGET|PRINT|LINE|RECT|RECTF|CIRCLE|SPRDEF|SPR)\\b"
                },
                {
                    "name": "support.function.input.basic2",
                    "match": "(?i)\\b(BTN|BTNP)\\b"
                },
                {
                    "name": "support.function.sound.basic2",
                    "match": "(?i)\\b(TONE)\\b"
                },
                {
                    "name": "support.function.math.basic2",
                    "match": "(?i)\\b(ABS|SGN|SQR|SIN|COS|TAN|ATN|EXP|LOG|INT|RND|MIN|MAX)\\b"
                },
                {
                    "name": "support.function.string.basic2",
                    "match": "(?i)\\b(LEN|MID\\$|LEFT\\$|RIGHT\\$|CHR\\$|ASC|STR\\$|VAL|INKEY\\$)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.basic2",
                    "match": "(?:\\$[0-9A-Fa-f]+|0[xX][0-9A-Fa-f]+)"
                },
                {
                    "name": "constant.numeric.float.basic2",
                    "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
                },
                {
                    "name": "constant.numeric.integer.basic2",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.basic2",
                    "match": "<=|>=|<>|!=|==|=|<|>"
                },
                {
                    "name": "keyword.operator.arithmetic.basic2",
                    "match": "[+\\-*/^]"
                }
            ]
        }
    }
}