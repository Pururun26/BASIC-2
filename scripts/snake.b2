' === main.b2 ===
' ============================================================
' SNAKE for BASIC-2
' Arrows/WASD - turn, A - restart after game over
' ============================================================

' === game.b2 ===
GLOBAL SX, SY, DX, DY, FX, FY, SIZE, ALIVE, TICK

DIM GLOBAL BX(100)
DIM GLOBAL BY(100)

SX = 8
SY = 8
DX = 1
DY = 0
FX = 12
FY = 8
SIZE = 3
ALIVE = 1

BX(0) = 8
BX(1) = 7
BX(2) = 6
BY(0) = 8
BY(1) = 8
BY(2) = 8

SUB RESET
  SX = 8
  SY = 8
  DX = 1
  DY = 0
  FX = 12
  FY = 8
  SIZE = 3
  ALIVE = 1
  BX(0) = 8
  BX(1) = 7
  BX(2) = 6
  BY(0) = 8
  BY(1) = 8
  BY(2) = 8
END SUB

SUB UPDATE
  IF ALIVE = 0 THEN
    CLS 0
    PRINT "GAME OVER"
    PRINT "SCORE:"
    PRINT SIZE - 3
    PRINT "PRESS A"
    IF BTNP(4) THEN CALL RESET
  ELSE
    ' --- ввод (каждый кадр, чтобы не пропускать нажатия) ---
    IF BTN(0) THEN
      IF DX = 0 THEN
        DX = -1
        DY = 0
      END IF
    END IF
    IF BTN(1) THEN
      IF DX = 0 THEN
        DX = 1
        DY = 0
      END IF
    END IF
    IF BTN(2) THEN
      IF DY = 0 THEN
        DX = 0
        DY = -1
      END IF
    END IF
    IF BTN(3) THEN
      IF DY = 0 THEN
        DX = 0
        DY = 1
      END IF
    END IF

    ' --- движение раз в 3 кадра ---
    TICK = TICK + 1
    IF TICK >= 5 THEN
      TICK = 0

      SX = SX + DX
      SY = SY + DY

      IF (SX < 0) OR (SX > 15) THEN
        TONE 110, 20, 100, 3
        ALIVE = 0
      END IF
      IF (SY < 0) OR (SY > 15) THEN
        TONE 110, 20, 100, 3
        ALIVE = 0
      END IF

      IF ALIVE = 1 THEN
        FOR I = SIZE - 1 TO 1 STEP -1
          BX(I) = BX(I - 1)
          BY(I) = BY(I - 1)
        NEXT I
        BX(0) = SX
        BY(0) = SY

        FOR I = 1 TO SIZE - 1
          IF (BX(I) = SX) AND (BY(I) = SY) THEN
            ALIVE = 0
          END IF
        NEXT I

        IF (SX = FX) AND (SY = FY) THEN
          SIZE = SIZE + 1
          FX = INT(RND(15))
          FY = INT(RND(15))
          TONE 880, 4, 80, 0
        END IF
      END IF
    END IF

    ' --- отрисовка каждый кадр (плавно) ---
    CLS 0
    RECT 0, 0, 96, 96, 1
    RECT 1, 1, 94, 94, 0
    RECT FX * 6 + 1, FY * 6 + 1, 4, 4, 1

    FOR I = 0 TO SIZE - 1
      RECT BX(I) * 6, BY(I) * 6, 6, 6, 1
    NEXT I

    PRINT "SCORE:"
    PRINT SIZE - 3
  END IF
END SUB
